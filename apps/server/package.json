{
  "name": "@cinelndex/server",
  "version": "0.1.0",
  "private": true,
  "description": "Cinelndex Express + PostgreSQL 后端",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node scripts/copy-assets.mjs && node --test --test-isolation=none \"dist/**/*.test.js\"",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts up",
    "db:rollback": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts down",
    "db:status": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts status",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/db/seed.ts",
    "db:reset": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts down && node --env-file-if-exists=.env --import tsx src/db/migrate.ts up && node --env-file-if-exists=.env --import tsx src/db/seed.ts",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\""
  },
  "dependencies": {
    "@cinelndex/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
