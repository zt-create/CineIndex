# 复制一份到 apps/server/.env 和 apps/client/.env 后按需修改
#   Copy-Item apps/server/.env.example apps/server/.env
#   Copy-Item apps/client/.env.example apps/client/.env

# ── 服务端（apps/server/.env）──────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://cinelndex:cinelndex@localhost:5432/cinelndex

# ── 前端（apps/client/.env）────────────────────────────
# 留空则走 Vite 代理 /api → http://localhost:4000
VITE_API_BASE_URL=
