# ── 服务端 ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# 前端地址，用于 CORS 白名单；多个用英文逗号分隔
CORS_ORIGIN=http://localhost:5173

# ── PostgreSQL ─────────────────────────────────────────
# 用 docker compose 起的默认实例（pnpm db:up）：
DATABASE_URL=postgresql://cinelndex:cinelndex@localhost:5432/cinelndex
#
# 如果本机 5432 已被别的 PostgreSQL 占用，可以换个端口起容器：
#   $env:POSTGRES_HOST_PORT=55432; pnpm db:up
#   DATABASE_URL=postgresql://cinelndex:cinelndex@localhost:55432/cinelndex

# 连接池
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=5000
# 设为 true 时打印 SQL
DB_LOGGING=false

# ── 日志 ───────────────────────────────────────────────
LOG_LEVEL=info
